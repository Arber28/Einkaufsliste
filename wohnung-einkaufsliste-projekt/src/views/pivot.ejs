<%- include('partials/header', { title: 'Pivot-Übersicht' }) %>

<%
function fmt(val) {
  const n = parseFloat(val || 0);
  if (n === 0) return '–';
  return n.toFixed(2).replace('.', ',');
}
function fmtFull(val) {
  const n = parseFloat(val || 0);
  return n.toFixed(2).replace('.', ',');
}
%>

<section class="card">
  <div class="pivot-header">
    <a href="/" class="back-link">← Zurück</a>
    <h2>Pivot-Übersicht</h2>
  </div>

  <h3 class="pivot-section-title offen-title">📋 Noch zu kaufen</h3>
  <% if (offen.raeume.length === 0) { %>
    <p class="empty-state">Keine offenen Artikel.</p>
  <% } else { %>
  <div class="pivot-table-wrap">
    <table class="pivot-table">
      <thead>
        <tr>
          <th class="col-raum">Raum</th>
          <th class="col-prio">🔴</th>
          <th class="col-prio">🟠</th>
          <th class="col-prio">🟡</th>
          <th class="col-prio">⚪</th>
          <th class="col-gesamt">Gesamt</th>
        </tr>
      </thead>
      <tbody>
        <% offen.raeume.forEach(function(raum, idx) {
           const uid = 'o' + idx;
        %>
        <tr class="raum-row" onclick="toggleDetail('<%= uid %>', this)">
          <td class="col-raum raum-cell"><span class="raum-chevron">▶</span> <%= raum %></td>
          <% for (let p = 0; p < 4; p++) { %>
            <td class="col-prio num-col prio-col-<%= p %>"><%= fmt(offen.matrix[raum][p]) %></td>
          <% } %>
          <td class="col-gesamt num-col"><strong><%= fmt(offen.matrix[raum].gesamt) %></strong></td>
        </tr>
        <% offen.artikel[raum].forEach(function(item) { %>
        <tr class="detail-row detail-<%= uid %>" style="display:none">
          <td class="col-raum detail-name">↳ <%= item.artikel %></td>
          <% for (let p = 0; p < 4; p++) { %>
            <td class="col-prio num-col prio-col-<%= p %>">
              <%= item.prio === p ? fmtFull(item.preis_planung) : '' %>
            </td>
          <% } %>
          <td class="col-gesamt num-col"><%= fmtFull(item.preis_planung) %></td>
        </tr>
        <% }); %>
        <% }); %>
      </tbody>
      <tfoot>
        <tr class="sum-row">
          <td class="col-raum">Gesamt</td>
          <% for (let p = 0; p < 4; p++) { %>
            <td class="col-prio num-col prio-col-<%= p %>"><strong><%= fmt(offen.spaltensummen[p]) %></strong></td>
          <% } %>
          <td class="col-gesamt num-col"><strong><%= fmt(offen.spaltensummen.gesamt) %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>

  <div class="pivot-divider"></div>

  <h3 class="pivot-section-title gekauft-title">✅ Schon gekauft</h3>
  <% if (gekauft.raeume.length === 0) { %>
    <p class="empty-state">Noch nichts gekauft.</p>
  <% } else { %>
  <div class="pivot-table-wrap">
    <table class="pivot-table pivot-table-gekauft">
      <thead>
        <tr>
          <th class="col-raum">Raum</th>
          <th class="col-prio">🔴</th>
          <th class="col-prio">🟠</th>
          <th class="col-prio">🟡</th>
          <th class="col-prio">⚪</th>
          <th class="col-gesamt">Gesamt</th>
        </tr>
      </thead>
      <tbody>
        <% gekauft.raeume.forEach(function(raum, idx) {
           const uid = 'g' + idx;
        %>
        <tr class="raum-row" onclick="toggleDetail('<%= uid %>', this)">
          <td class="col-raum raum-cell"><span class="raum-chevron">▶</span> <%= raum %></td>
          <% for (let p = 0; p < 4; p++) { %>
            <td class="col-prio num-col prio-col-<%= p %>"><%= fmt(gekauft.matrix[raum][p]) %></td>
          <% } %>
          <td class="col-gesamt num-col"><strong><%= fmt(gekauft.matrix[raum].gesamt) %></strong></td>
        </tr>
        <% gekauft.artikel[raum].forEach(function(item) { %>
        <tr class="detail-row detail-<%= uid %>" style="display:none">
          <td class="col-raum detail-name">↳ <%= item.artikel %></td>
          <% for (let p = 0; p < 4; p++) { %>
            <td class="col-prio num-col prio-col-<%= p %>">
              <%= item.prio === p ? fmtFull(item.preis_tatsaechlich) : '' %>
            </td>
          <% } %>
          <td class="col-gesamt num-col"><%= fmtFull(item.preis_tatsaechlich) %></td>
        </tr>
        <% }); %>
        <% }); %>
      </tbody>
      <tfoot>
        <tr class="sum-row">
          <td class="col-raum">Gesamt</td>
          <% for (let p = 0; p < 4; p++) { %>
            <td class="col-prio num-col prio-col-<%= p %>"><strong><%= fmt(gekauft.spaltensummen[p]) %></strong></td>
          <% } %>
          <td class="col-gesamt num-col"><strong><%= fmt(gekauft.spaltensummen.gesamt) %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>
</section>

<script>
function toggleDetail(uid, row) {
  const rows = document.querySelectorAll('.detail-' + uid);
  const chevron = row.querySelector('.raum-chevron');
  const isOpen = rows[0] && rows[0].style.display !== 'none';
  rows.forEach(function(r) { r.style.display = isOpen ? 'none' : ''; });
  if (chevron) chevron.textContent = isOpen ? '▶' : '▼';
}
</script>

<%- include('partials/footer') %>
