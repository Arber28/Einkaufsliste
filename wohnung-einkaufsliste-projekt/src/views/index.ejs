<%- include('partials/header', { title: 'Übersicht' }) %>

<%
const PRIO_LABEL = ['🔴 Sofort', '🟠 Wichtig', '🟡 Normal', '⚪ Optional'];
const PRIO_CLASS = ['prio-sofort', 'prio-wichtig', 'prio-normal', 'prio-optional'];
function fmt(val) {
  return parseFloat(val || 0).toFixed(2).replace('.', ',') + ' €';
}
%>

<section class="dashboard-card">
  <div class="dashboard-grid">
    <div class="dash-item">
      <span class="dash-label">Geplante Kosten</span>
      <span class="dash-value"><%= fmt(summePlanung) %></span>
    </div>
    <div class="dash-item">
      <span class="dash-label">Ausgegeben</span>
      <span class="dash-value"><%= fmt(summeTatsaechlich) %></span>
    </div>
    <div class="dash-item dash-ersparnis">
      <span class="dash-label">Ersparnis / Mehrkosten</span>
      <span class="dash-value <%= ersparnis >= 0 ? 'text-green' : 'text-red' %>">
        <%= ersparnis >= 0 ? '+' : '' %><%= fmt(ersparnis) %>
      </span>
    </div>
  </div>
  <a href="/pivot" class="btn-pivot">📊 Pivot-Übersicht ansehen →</a>
</section>

<section class="card">
  <form method="GET" action="/" id="filterForm" class="filter-bar">

    <input type="hidden" name="status" id="statusInput" value="<%= filter.status %>">

    <div class="filter-group">
      <span class="filter-label">Status</span>
      <div class="filter-pills">
        <button type="button" onclick="setStatus('alle')"
          class="pill <%= filter.status === 'alle' ? 'pill-active' : '' %>">Alle</button>
        <button type="button" onclick="setStatus('offen')"
          class="pill <%= filter.status === 'offen' ? 'pill-active' : '' %>">Offen</button>
        <button type="button" onclick="setStatus('gekauft')"
          class="pill <%= filter.status === 'gekauft' ? 'pill-active' : '' %>">Gekauft</button>
      </div>
    </div>

    <div class="filter-group">
      <span class="filter-label">Priorität</span>
      <div class="filter-pills">
        <% PRIO_LABEL.forEach(function(label, i) { %>
          <label class="pill pill-check <%= filter.prio.includes(String(i)) ? 'pill-active' : '' %>">
            <input type="checkbox" name="prio" value="<%= i %>"
              <%= filter.prio.includes(String(i)) ? 'checked' : '' %>
              onchange="this.form.submit()" hidden>
            <%= label %>
          </label>
        <% }); %>
      </div>
    </div>

    <% if (orte.length) { %>
    <div class="filter-group">
      <span class="filter-label">Ort</span>
      <div class="filter-pills">
        <% orte.forEach(function(o) { %>
          <label class="pill pill-check <%= filter.ort.includes(o) ? 'pill-active' : '' %>">
            <input type="checkbox" name="ort" value="<%= o %>"
              <%= filter.ort.includes(o) ? 'checked' : '' %>
              onchange="this.form.submit()" hidden>
            <%= o %>
          </label>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% if (raeume.length) { %>
    <div class="filter-group">
      <span class="filter-label">Raum</span>
      <div class="filter-pills">
        <% raeume.forEach(function(r) { %>
          <label class="pill pill-check <%= filter.raum.includes(r) ? 'pill-active' : '' %>">
            <input type="checkbox" name="raum" value="<%= r %>"
              <%= filter.raum.includes(r) ? 'checked' : '' %>
              onchange="this.form.submit()" hidden>
            <%= r %>
          </label>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% if (filter.status !== 'alle' || filter.raum.length || filter.prio.length || filter.ort.length) { %>
      <a href="/" class="filter-reset">✕ Filter zurücksetzen</a>
    <% } %>

  </form>

  <div class="section-title-row">
    <h2 class="section-title">
      Artikel <span class="badge"><%= rows.length %></span>
    </h2>
  </div>

  <% if (rows.length > 0) { %>
    <div class="sum-strip">
      Summe der angezeigten Artikel: <strong><%= fmt(summeAngezeigt) %></strong>
    </div>
  <% } %>

  <% if (rows.length === 0) { %>
    <p class="empty-state">Keine Artikel gefunden.</p>
  <% } else {
    let currentRaum = null;
  %>
    <div class="karten-grid">
    <% rows.forEach(function(row) {
      const raum = row.raum || '(kein Raum)';
      const itemLinks = (row.links && row.links.length) ? row.links : (row.link ? [row.link] : []);
      const imgs = (row.image_paths && row.image_paths.length) ? row.image_paths.filter(Boolean) : (row.image_path ? [row.image_path] : []);
    %>
      <% if (raum !== currentRaum) { currentRaum = raum; %>
        <div class="karten-raum-header"><%= raum %></div>
      <% } %>

      <div class="karte <%= PRIO_CLASS[row.prio] %> <%= row.status === 'gekauft' ? 'karte-gekauft' : '' %>">
        <% if (imgs.length > 0) { %>
          <div class="karte-imgs">
            <% imgs.forEach(function(fname) { %>
              <img src="/uploads/<%= fname %>" alt="" loading="lazy">
            <% }); %>
          </div>
        <% } %>
        <div class="karte-body">
          <div class="karte-name">
            <%= row.artikel %>
            <% itemLinks.forEach(function(l, i) { %>
              <a href="<%= l %>" target="_blank" rel="noopener" class="link-icon" title="<%= l %>">🔗<% if (itemLinks.length > 1) { %><sub><%= i+1 %></sub><% } %></a>
            <% }); %>
          </div>
          <% if (row.anmerkungen) { %>
            <div class="karte-anmerkung"><%= row.anmerkungen %></div>
          <% } %>
          <div class="karte-meta">
            <span class="prio-badge prio-badge-<%= row.prio %>"><%= PRIO_LABEL[row.prio] %></span>
            <span class="ort-badge"><%= row.ort %></span>
          </div>
          <div class="karte-footer">
            <div class="karte-preis-zeile">
              <% if (row.status === 'offen') { %>
                <span class="preis-plan">Plan: <strong><%= fmt(row.preis_planung) %></strong></span>
              <% } else { %>
                <div>
                  <div class="preis-plan">Plan: <span class="text-muted"><%= fmt(row.preis_planung) %></span></div>
                  <div class="preis-echt text-green">✓ <%= fmt(row.preis_tatsaechlich) %></div>
                </div>
              <% } %>
              <div class="karte-icons">
                <a href="/edit/<%= row.id %>" class="btn-icon" title="Bearbeiten">✏️</a>
                <form action="/delete/<%= row.id %>" method="POST" onsubmit="return confirm('Löschen?')">
                  <button type="submit" class="btn-delete">✕</button>
                </form>
              </div>
            </div>
            <% if (row.status === 'offen') { %>
              <form action="/kaufen/<%= row.id %>" method="POST" class="kauf-form">
                <input type="number" name="preis_tatsaechlich" step="0.01" min="0"
                  class="input-preis"
                  value="<%= parseFloat(row.preis_planung || 0).toFixed(2) %>">
                <button type="submit" class="btn-ok">✓</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
    </div>
  <% } %>
</section>

<a href="/new" class="fab">+</a>

<script>
function setStatus(value) {
  document.getElementById('statusInput').value = value;
  document.getElementById('filterForm').submit();
}
</script>

<%- include('partials/footer') %>
