<%- include('partials/header', { title: 'Neuer Artikel' }) %>

<section class="card form-card">
  <div class="form-header">
    <a href="/" class="back-link">← Zurück</a>
    <h2>Neuer Artikel</h2>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/new" method="POST" enctype="multipart/form-data" class="artikel-form">
    <div class="field-group">
      <label for="artikel">Artikel <span class="required">*</span></label>
      <input type="text" id="artikel" name="artikel" placeholder="z.B. Sofa, Kühlschrank..." required>
    </div>

    <div class="field-group">
      <label>Produktlinks <span class="field-hint">(beliebig viele)</span></label>
      <div id="linksContainer">
        <div class="link-input-row">
          <input type="url" name="link" placeholder="https://...">
          <button type="button" class="btn-link-remove" onclick="removeLink(this)">✕</button>
        </div>
      </div>
      <button type="button" class="btn-link-add" onclick="addLink()">+ Link hinzufügen</button>
    </div>

    <div class="field-group">
      <label>Bilder <span class="field-hint">(quadratisch, max. 10 MB pro Bild)</span></label>
      <input type="file" id="bildInput" name="bilder" accept="image/*" multiple style="display:none" onchange="onFilesSelected(this)">
      <div class="img-slots" id="imgSlots"></div>
      <button type="button" class="img-add-btn" id="addBtn" onclick="document.getElementById('bildInput').click()">
        + Bild hinzufügen
      </button>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label for="raum">Raum</label>
        <input type="text" id="raum" name="raum" placeholder="z.B. Wohnzimmer" list="raum-vorschlaege">
        <datalist id="raum-vorschlaege">
          <option value="Wohnzimmer">
          <option value="Schlafzimmer">
          <option value="Küche">
          <option value="Bad">
          <option value="Flur">
          <option value="Büro">
          <option value="Balkon">
          <option value="Keller">
        </datalist>
      </div>
      <div class="field-group">
        <label for="preis_planung">Preisvorstellung</label>
        <input type="number" id="preis_planung" name="preis_planung" step="0.01" min="0" placeholder="0,00">
      </div>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label for="prio">Priorität</label>
        <select id="prio" name="prio">
          <option value="0">🔴 0 – Sofort</option>
          <option value="1">🟠 1 – Wichtig</option>
          <option value="2" selected>🟡 2 – Normal</option>
          <option value="3">⚪ 3 – Optional</option>
        </select>
      </div>
      <div class="field-group">
        <label for="ort">Kaufort</label>
        <select id="ort" name="ort">
          <option value="Österreich" selected>🇦🇹 Österreich</option>
          <option value="Kosovo">🇽🇰 Kosovo</option>
        </select>
      </div>
    </div>

    <div class="field-group">
      <label for="anmerkungen">Anmerkungen</label>
      <textarea id="anmerkungen" name="anmerkungen" rows="3" placeholder="Farbe, Maße, Besonderheiten..."></textarea>
    </div>

    <div class="form-actions">
      <a href="/" class="btn btn-outline">Abbrechen</a>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </div>
  </form>
</section>

<script>
function addLink() {
  const c = document.getElementById('linksContainer');
  const row = document.createElement('div');
  row.className = 'link-input-row';
  row.innerHTML = '<input type="url" name="link" placeholder="https://..."><button type="button" class="btn-link-remove" onclick="removeLink(this)">✕</button>';
  c.appendChild(row);
  row.querySelector('input').focus();
}
function removeLink(btn) {
  const c = document.getElementById('linksContainer');
  if (c.children.length > 1) btn.parentElement.remove();
  else btn.previousElementSibling.value = '';
}

// Multi-image upload
const dataTransfer = new DataTransfer();

function onFilesSelected(input) {
  Array.from(input.files).forEach(file => {
    dataTransfer.items.add(file);
    addPreviewSlot(file, null);
  });
  input.value = '';
  syncFileInput();
}

function addPreviewSlot(file, existingName) {
  const slots = document.getElementById('imgSlots');
  const slot = document.createElement('div');
  slot.className = 'img-slot';
  if (existingName) slot.dataset.existing = existingName;
  const img = document.createElement('img');
  if (file) {
    const reader = new FileReader();
    reader.onload = e => img.src = e.target.result;
    reader.readAsDataURL(file);
  }
  const del = document.createElement('button');
  del.type = 'button';
  del.className = 'img-slot-del';
  del.textContent = '✕';
  del.onclick = () => {
    if (file) {
      const arr = Array.from(dataTransfer.files);
      const idx = arr.indexOf(file);
      if (idx >= 0) {
        const dt2 = new DataTransfer();
        arr.forEach((f, i) => { if (i !== idx) dt2.items.add(f); });
        dataTransfer.items.clear();
        Array.from(dt2.files).forEach(f => dataTransfer.items.add(f));
        syncFileInput();
      }
    }
    slot.remove();
  };
  slot.appendChild(img);
  slot.appendChild(del);
  slots.appendChild(slot);
}

function syncFileInput() {
  const input = document.getElementById('bildInput');
  const dt = new DataTransfer();
  Array.from(dataTransfer.files).forEach(f => dt.items.add(f));
  input.files = dt.files;
}
</script>

<%- include('partials/footer') %>
