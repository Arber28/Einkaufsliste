<%- include('partials/header', { title: 'Artikel bearbeiten' }) %>

<section class="card form-card">
  <div class="form-header">
    <a href="/" class="back-link">← Zurück</a>
    <h2>Artikel bearbeiten</h2>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/edit/<%= item.id %>" method="POST" enctype="multipart/form-data" class="artikel-form" id="editForm">

    <div class="field-group">
      <label for="artikel">Artikel <span class="required">*</span></label>
      <input type="text" id="artikel" name="artikel" value="<%= item.artikel %>" required>
    </div>

    <div class="field-group">
      <label>Produktlinks <span class="field-hint">(beliebig viele)</span></label>
      <div id="linksContainer">
        <% const itemLinks = (item.links && item.links.length) ? item.links : (item.link ? [item.link] : ['']); %>
        <% itemLinks.forEach(function(l) { %>
          <div class="link-input-row">
            <input type="url" name="link" value="<%= l %>" placeholder="https://...">
            <button type="button" class="btn-link-remove" onclick="removeLink(this)">✕</button>
          </div>
        <% }); %>
      </div>
      <button type="button" class="btn-link-add" onclick="addLink()">+ Link hinzufügen</button>
    </div>

    <div class="field-group">
      <label>Bilder <span class="field-hint">(quadratisch, max. 10 MB pro Bild)</span></label>
      <input type="file" id="bildInput" name="bilder" accept="image/*" multiple style="display:none" onchange="onFilesSelected(this)">
      <div class="img-slots" id="imgSlots">
        <% const existingImages = item.image_paths && item.image_paths.length ? item.image_paths : (item.image_path ? [item.image_path] : []); %>
        <% existingImages.filter(Boolean).forEach(function(fname) { %>
          <div class="img-slot" data-existing="<%= fname %>">
            <img src="/uploads/<%= fname %>" alt="">
            <button type="button" class="img-slot-del" onclick="removeExisting(this, '<%= fname %>')">✕</button>
          </div>
        <% }); %>
      </div>
      <button type="button" class="img-add-btn" onclick="document.getElementById('bildInput').click()">
        + Bild hinzufügen
      </button>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label for="raum">Raum</label>
        <input type="text" id="raum" name="raum" value="<%= item.raum || '' %>" placeholder="z.B. Wohnzimmer" list="raum-vorschlaege">
        <datalist id="raum-vorschlaege">
          <option value="Wohnzimmer">
          <option value="Schlafzimmer">
          <option value="Küche">
          <option value="Bad">
          <option value="Flur">
          <option value="Büro">
          <option value="Balkon">
          <option value="Keller">
        </datalist>
      </div>
      <div class="field-group">
        <label for="preis_planung">Preisvorstellung</label>
        <input type="number" id="preis_planung" name="preis_planung" step="0.01" min="0"
          value="<%= parseFloat(item.preis_planung || 0).toFixed(2) %>">
      </div>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label for="prio">Priorität</label>
        <select id="prio" name="prio">
          <option value="0" <%= item.prio == 0 ? 'selected' : '' %>>🔴 0 – Sofort</option>
          <option value="1" <%= item.prio == 1 ? 'selected' : '' %>>🟠 1 – Wichtig</option>
          <option value="2" <%= item.prio == 2 ? 'selected' : '' %>>🟡 2 – Normal</option>
          <option value="3" <%= item.prio == 3 ? 'selected' : '' %>>⚪ 3 – Optional</option>
        </select>
      </div>
      <div class="field-group">
        <label for="ort">Kaufort</label>
        <select id="ort" name="ort">
          <option value="Österreich" <%= item.ort === 'Österreich' ? 'selected' : '' %>>🇦🇹 Österreich</option>
          <option value="Kosovo" <%= item.ort === 'Kosovo' ? 'selected' : '' %>>🇽🇰 Kosovo</option>
        </select>
      </div>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="offen"   <%= item.status === 'offen'   ? 'selected' : '' %>>📋 Offen</option>
          <option value="gekauft" <%= item.status === 'gekauft' ? 'selected' : '' %>>✅ Gekauft</option>
        </select>
      </div>
      <div class="field-group">
        <label for="preis_tatsaechlich">Tatsächlicher Preis</label>
        <input type="number" id="preis_tatsaechlich" name="preis_tatsaechlich" step="0.01" min="0"
          value="<%= parseFloat(item.preis_tatsaechlich || 0).toFixed(2) %>">
      </div>
    </div>

    <div class="field-group">
      <label for="anmerkungen">Anmerkungen</label>
      <textarea id="anmerkungen" name="anmerkungen" rows="3" placeholder="Farbe, Maße, Besonderheiten..."><%= item.anmerkungen || '' %></textarea>
    </div>

    <div class="form-actions">
      <a href="/" class="btn btn-outline">Abbrechen</a>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </div>
  </form>
</section>

<script>
function addLink() {
  const c = document.getElementById('linksContainer');
  const row = document.createElement('div');
  row.className = 'link-input-row';
  row.innerHTML = '<input type="url" name="link" placeholder="https://..."><button type="button" class="btn-link-remove" onclick="removeLink(this)">✕</button>';
  c.appendChild(row);
  row.querySelector('input').focus();
}
function removeLink(btn) {
  const c = document.getElementById('linksContainer');
  if (c.children.length > 1) btn.parentElement.remove();
  else btn.previousElementSibling.value = '';
}

// Remove existing saved image: add hidden delete_image input
function removeExisting(btn, fname) {
  const form = document.getElementById('editForm');
  const hidden = document.createElement('input');
  hidden.type = 'hidden';
  hidden.name = 'delete_image';
  hidden.value = fname;
  form.appendChild(hidden);
  btn.closest('.img-slot').remove();
}

// New files added
const dataTransfer = new DataTransfer();

function onFilesSelected(input) {
  Array.from(input.files).forEach(file => {
    dataTransfer.items.add(file);
    addNewSlot(file);
  });
  input.value = '';
  syncFileInput();
}

function addNewSlot(file) {
  const slots = document.getElementById('imgSlots');
  const slot = document.createElement('div');
  slot.className = 'img-slot';
  const img = document.createElement('img');
  const reader = new FileReader();
  reader.onload = e => img.src = e.target.result;
  reader.readAsDataURL(file);
  const del = document.createElement('button');
  del.type = 'button';
  del.className = 'img-slot-del';
  del.textContent = '✕';
  del.onclick = () => {
    const arr = Array.from(dataTransfer.files);
    const idx = arr.indexOf(file);
    if (idx >= 0) {
      dataTransfer.items.clear();
      arr.forEach((f, i) => { if (i !== idx) dataTransfer.items.add(f); });
      syncFileInput();
    }
    slot.remove();
  };
  slot.appendChild(img);
  slot.appendChild(del);
  slots.appendChild(slot);
}

function syncFileInput() {
  const dt = new DataTransfer();
  Array.from(dataTransfer.files).forEach(f => dt.items.add(f));
  document.getElementById('bildInput').files = dt.files;
}
</script>

<%- include('partials/footer') %>
